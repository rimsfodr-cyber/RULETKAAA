<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>DARTVEL | Премиум Рулетка Metro Royale</title>
  <!-- Google Fonts: Montserrat -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Montserrat', sans-serif;
      background: #0a0a0a;
      color: #fff;
      overflow: hidden;
      height: 100vh;
      width: 100vw;
      position: relative;
      touch-action: pan-y;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    /* Фоновые параллакс-частицы (общие) */
    .particles-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
      opacity: 0.25;
    }

    .particle {
      position: absolute;
      background: radial-gradient(circle, #ffd700 0%, transparent 70%);
      border-radius: 50%;
      animation: floatUp linear infinite;
    }

    @keyframes floatUp {
      0% { transform: translateY(0) scale(1); opacity: 0; }
      10% { opacity: 0.8; }
      90% { opacity: 0.6; }
      100% { transform: translateY(-110vh) scale(0.5); opacity: 0; }
    }

    /* Интерактивные золотые частицы для первого экрана */
    .gold-particles-container {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 2;
      overflow: hidden;
    }

    .gold-particle {
      position: absolute;
      pointer-events: none;
      will-change: transform, opacity;
      animation: goldFloat 6s ease-in-out infinite;
      filter: drop-shadow(0 0 6px rgba(255, 215, 0, 0.8));
    }

    @keyframes goldFloat {
      0%, 100% {
        transform: translate(0, 0) scale(1) rotate(0deg);
        opacity: 0.4;
      }
      25% {
        transform: translate(30px, -40px) scale(1.3) rotate(90deg);
        opacity: 0.9;
      }
      50% {
        transform: translate(-20px, -80px) scale(0.9) rotate(180deg);
        opacity: 0.6;
      }
      75% {
        transform: translate(15px, -50px) scale(1.1) rotate(270deg);
        opacity: 0.8;
      }
    }

    /* Разные вариации анимации для частиц */
    .gold-particle:nth-child(odd) {
      animation-duration: 7s;
      animation-delay: -2s;
    }

    .gold-particle:nth-child(3n) {
      animation-duration: 5.5s;
      animation-delay: -4s;
    }

    .gold-particle:nth-child(4n+1) {
      animation-duration: 8s;
      animation-delay: -1s;
    }

    .gold-particle:nth-child(5n+2) {
      animation-duration: 6.5s;
      animation-delay: -3s;
    }

    .app-container {
      position: relative;
      width: 100%;
      height: 100%;
      z-index: 1;
      transition: transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      will-change: transform;
    }

    .screen {
      width: 100%;
      height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      padding: 20px;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    .screen-landing {
      background: radial-gradient(ellipse at center, #1a1a1a 0%, #0a0a0a 70%);
      gap: 25px;
      position: relative;
    }

    /* Затемнение для улучшения читаемости текста на фоне частиц */
    .screen-landing::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(ellipse at center, transparent 30%, rgba(10, 10, 10, 0.6) 100%);
      pointer-events: none;
      z-index: 3;
    }

    .logo {
      font-size: clamp(2.8rem, 10vw, 4.5rem);
      font-weight: 800;
      letter-spacing: 6px;
      background: linear-gradient(180deg, #ffd700 20%, #b8860b 80%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-shadow: 0 0 30px rgba(255, 215, 0, 0.4);
      filter: drop-shadow(0 0 20px #ffd70066);
      animation: logoGlow 2s ease-in-out infinite alternate;
      position: relative;
      z-index: 5;
    }

    @keyframes logoGlow {
      0% { filter: drop-shadow(0 0 15px #ffd70055); }
      100% { filter: drop-shadow(0 0 35px #ffd700aa); }
    }

    .subtitle {
      font-size: 1.1rem;
      text-align: center;
      color: #ccc;
      max-width: 320px;
      line-height: 1.6;
      letter-spacing: 0.5px;
      background: rgba(255,255,255,0.03);
      backdrop-filter: blur(10px);
      padding: 15px 20px;
      border-radius: 20px;
      border: 1px solid rgba(255,215,0,0.15);
      position: relative;
      z-index: 5;
    }

    .tg-links {
      display: flex;
      flex-direction: column;
      gap: 14px;
      width: 100%;
      max-width: 300px;
      position: relative;
      z-index: 5;
    }

    .tg-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: rgba(255,255,255,0.05);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255,215,0,0.3);
      padding: 14px 20px;
      border-radius: 40px;
      color: #ffd700;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.3s ease;
      font-size: 0.95rem;
      letter-spacing: 0.5px;
    }

    .tg-btn:hover {
      background: rgba(255,215,0,0.1);
      border-color: #ffd700;
      box-shadow: 0 0 25px rgba(255,215,0,0.2);
      transform: translateY(-2px);
    }

    .nav-down-btn {
      margin-top: 15px;
      background: linear-gradient(135deg, #ffd700, #b8860b);
      border: none;
      padding: 16px 32px;
      border-radius: 50px;
      font-weight: 700;
      font-size: 1.1rem;
      color: #0a0a0a;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 10px;
      letter-spacing: 1px;
      box-shadow: 0 8px 30px rgba(255,215,0,0.3);
      transition: all 0.3s ease;
      position: relative;
      z-index: 5;
    }

    .nav-down-btn:hover {
      box-shadow: 0 12px 40px rgba(255,215,0,0.5);
      transform: scale(1.03);
    }

    .arrow-down {
      font-size: 1.4rem;
      animation: bounceDown 1.2s infinite;
    }

    @keyframes bounceDown {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(6px); }
    }

    /* Экран 2: Рулетка */
    .screen-roulette {
      background: #0a0a0a;
      justify-content: flex-start;
      padding-top: 20px;
      gap: 15px;
    }

    .balance-panel {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      max-width: 420px;
      background: rgba(20,20,20,0.9);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255,215,0,0.25);
      border-radius: 60px;
      padding: 8px 8px 8px 20px;
      margin-bottom: 5px;
    }

    .spin-count {
      font-weight: 700;
      font-size: 1.3rem;
      color: #ffd700;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .btn-buy, .btn-paid {
      background: #ffd700;
      border: none;
      padding: 10px 18px;
      border-radius: 40px;
      font-weight: 700;
      font-size: 0.85rem;
      color: #0a0a0a;
      cursor: pointer;
      transition: all 0.2s;
      letter-spacing: 0.5px;
    }

    .btn-buy:hover, .btn-paid:hover {
      background: #ffed4a;
      box-shadow: 0 0 20px #ffd70088;
    }

    .btn-paid {
      background: transparent;
      border: 2px solid #ffd700;
      color: #ffd700;
      margin-left: 6px;
    }

    .btn-paid.hidden {
      display: none;
    }

    .wheel-container {
      position: relative;
      width: min(340px, 80vw);
      height: min(340px, 80vw);
      margin: 5px 0;
    }

    canvas#wheelCanvas {
      width: 100%;
      height: 100%;
      display: block;
      filter: drop-shadow(0 0 25px rgba(255,215,0,0.25));
      transition: filter 0.3s;
    }

    canvas#wheelCanvas.spinning {
      filter: drop-shadow(0 0 45px rgba(255,215,0,0.6)) blur(1px);
    }

    .wheel-pointer {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 0;
      border-left: 18px solid transparent;
      border-right: 18px solid transparent;
      border-top: 28px solid #ffd700;
      filter: drop-shadow(0 0 12px #ffd700);
      z-index: 5;
    }

    .spin-btn {
      background: linear-gradient(180deg, #ffd700 0%, #b8860b 100%);
      border: none;
      padding: 16px 50px;
      border-radius: 50px;
      font-weight: 800;
      font-size: 1.2rem;
      letter-spacing: 2px;
      color: #0a0a0a;
      cursor: pointer;
      box-shadow: 0 6px 30px rgba(255,215,0,0.4);
      transition: all 0.25s;
      margin: 8px 0;
      text-transform: uppercase;
    }

    .spin-btn:active {
      transform: scale(0.96);
    }

    .spin-btn:disabled {
      opacity: 0.5;
      pointer-events: none;
      filter: grayscale(0.6);
    }

    .history-title {
      font-weight: 600;
      font-size: 0.9rem;
      color: #aaa;
      letter-spacing: 1px;
      margin-top: 5px;
    }

    .history-list {
      width: 100%;
      max-width: 420px;
      max-height: 180px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 8px;
      background: rgba(255,255,255,0.02);
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.05);
    }

    .history-item {
      display: flex;
      align-items: center;
      gap: 12px;
      background: rgba(255,255,255,0.03);
      padding: 10px 14px;
      border-radius: 30px;
      font-size: 0.85rem;
      animation: fadeInUp 0.3s ease;
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(15px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .history-icon {
      font-size: 1.5rem;
      width: 32px;
      text-align: center;
    }

    .history-details {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .history-name {
      font-weight: 600;
      color: #ddd;
    }

    .history-time {
      font-size: 0.7rem;
      color: #888;
    }

    .history-manager {
      font-size: 0.65rem;
      color: #ffd700;
      opacity: 0.9;
    }

    /* Модальное окно */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.8);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 100;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-card {
      background: linear-gradient(145deg, #1a1a1a, #0f0f0f);
      border: 2px solid #ffd700;
      border-radius: 30px;
      padding: 30px 25px;
      text-align: center;
      max-width: 320px;
      width: 85%;
      box-shadow: 0 0 60px rgba(255,215,0,0.25);
      position: relative;
      animation: modalPop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes modalPop {
      0% { transform: scale(0.8); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }

    .modal-icon {
      font-size: 4rem;
      margin-bottom: 10px;
      animation: rarePulse 0.8s infinite alternate;
    }

    .modal-icon.rare {
      filter: drop-shadow(0 0 30px gold);
    }

    @keyframes rarePulse {
      from { transform: scale(1); filter: drop-shadow(0 0 20px gold); }
      to { transform: scale(1.08); filter: drop-shadow(0 0 45px gold); }
    }

    .modal-name {
      font-weight: 700;
      font-size: 1.5rem;
      margin: 8px 0;
      color: #ffd700;
    }

    .modal-manager {
      margin: 10px 0 5px;
      font-size: 0.9rem;
      color: #ffd700;
      background: rgba(255,215,0,0.1);
      padding: 6px 15px;
      border-radius: 20px;
      display: inline-block;
      font-weight: 500;
      letter-spacing: 0.5px;
    }

    .modal-close {
      margin-top: 18px;
      background: #ffd700;
      border: none;
      padding: 12px 30px;
      border-radius: 40px;
      font-weight: 700;
      color: #0a0a0a;
      cursor: pointer;
    }

    .toast {
      position: fixed;
      top: 30px;
      left: 50%;
      transform: translateX(-50%);
      background: #ffd700;
      color: #0a0a0a;
      font-weight: 700;
      padding: 14px 28px;
      border-radius: 40px;
      z-index: 200;
      box-shadow: 0 10px 30px rgba(255,215,0,0.5);
      animation: toastIn 0.4s ease, toastOut 0.3s 1.8s forwards;
      pointer-events: none;
    }

    @keyframes toastIn {
      from { opacity: 0; transform: translateX(-50%) translateY(-30px); }
      to { opacity: 1; transform: translateX(-50%) translateY(0); }
    }
    @keyframes toastOut {
      to { opacity: 0; transform: translateX(-50%) translateY(-20px); }
    }

    @media (max-width: 480px) {
      .balance-panel {
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        padding: 12px;
      }
      .spin-btn {
        width: 90%;
        padding: 16px;
      }
      .wheel-container {
        width: 75vw;
        height: 75vw;
      }
      .gold-particle {
        animation-duration: 5s !important;
      }
    }
  </style>
</head>
<body>
  <!-- Общие фоновые частицы -->
  <div class="particles-bg" id="particlesBg"></div>

  <!-- Основной контейнер -->
  <div class="app-container" id="appContainer">
    <!-- Экран 1: Лендинг с интерактивными частицами -->
    <div class="screen screen-landing" id="screenLanding">
      <!-- Контейнер для интерактивных золотых частиц -->
      <div class="gold-particles-container" id="goldParticles"></div>
      
      <div class="logo">DARTVEL</div>
      <p class="subtitle">
        Премиум рулетка в стиле Metro Royale.<br>
        Эксклюзивные предметы, редкие дропы, VIP сопровождение.
      </p>
      <div class="tg-links">
        <a href="https://t.me/dartvelpubg" target="_blank" class="tg-btn">
          📢 DARTVEL PUBG
        </a>
        <a href="https://t.me/MetroShopDartvel" target="_blank" class="tg-btn">
          🛒 METRO SHOP
        </a>
      </div>
      <button class="nav-down-btn" id="goToRouletteBtn">
        Перейти к рулетке <span class="arrow-down">↓</span>
      </button>
    </div>

    <!-- Экран 2: Рулетка -->
    <div class="screen screen-roulette" id="screenRoulette">
      <div class="balance-panel">
        <span class="spin-count">🎫 Спины: <strong id="spinBalance">0</strong></span>
        <div>
          <button class="btn-buy" id="buySpinsBtn">Купить спины</button>
          <button class="btn-paid hidden" id="iPaidBtn">Я оплатил</button>
        </div>
      </div>

      <div class="wheel-container">
        <div class="wheel-pointer"></div>
        <canvas id="wheelCanvas" width="400" height="400"></canvas>
      </div>

      <button class="spin-btn" id="spinActionBtn">КРУТИТЬ</button>

      <div class="history-title">📋 История спинов</div>
      <div class="history-list" id="historyList">
        <div style="color:#555;text-align:center;padding:15px;">Пока нет спинов</div>
      </div>
    </div>
  </div>

  <!-- Модальное окно выигрыша -->
  <div class="modal-overlay" id="modalOverlay">
    <div class="modal-card">
      <div class="modal-icon" id="modalIcon">🎁</div>
      <div class="modal-name" id="modalName">Предмет</div>
      <div class="modal-manager" id="modalManager">@Dartvel_Manager</div>
      <button class="modal-close" id="modalCloseBtn">Закрыть</button>
    </div>
  </div>

  <script>
    (function() {
      // ============ КОНФИГУРАЦИЯ ПРЕДМЕТОВ ============
      const ITEMS = [
        { name: 'Золотая бабочка',  icon: '🦋', probability: 0.003, color: '#ffd700', glow: true,  rare: true },
        { name: 'Золотой меч',      icon: '⚔️', probability: 0.003, color: '#ffd700', glow: true,  rare: true },
        { name: 'Ф6х10',            icon: '🎯', probability: 0.1985, color: '#4da6ff', glow: false, rare: false },
        { name: 'Ф6 золото',        icon: '💰', probability: 0.1985, color: '#ffd700', glow: false, rare: false },
        { name: '60 UC',            icon: '💎', probability: 0.2985, color: '#c084fc', glow: false, rare: false },
        { name: 'Сопровождение VIP',icon: '👑', probability: 0.2985, color: '#4ade80', glow: false, rare: false }
      ];

      const SECTORS = ITEMS.map((item, i) => ({
        ...item,
        startAngle: (i * Math.PI * 2) / ITEMS.length,
        endAngle: ((i + 1) * Math.PI * 2) / ITEMS.length
      }));

      // ============ DOM ЭЛЕМЕНТЫ ============
      const appContainer = document.getElementById('appContainer');
      const goToRouletteBtn = document.getElementById('goToRouletteBtn');
      const spinBalanceEl = document.getElementById('spinBalance');
      const buySpinsBtn = document.getElementById('buySpinsBtn');
      const iPaidBtn = document.getElementById('iPaidBtn');
      const spinActionBtn = document.getElementById('spinActionBtn');
      const wheelCanvas = document.getElementById('wheelCanvas');
      const ctx = wheelCanvas.getContext('2d');
      const historyList = document.getElementById('historyList');
      const modalOverlay = document.getElementById('modalOverlay');
      const modalIcon = document.getElementById('modalIcon');
      const modalName = document.getElementById('modalName');
      const modalManager = document.getElementById('modalManager');
      const modalCloseBtn = document.getElementById('modalCloseBtn');
      const particlesBg = document.getElementById('particlesBg');
      const goldParticlesContainer = document.getElementById('goldParticles');

      // ============ СОСТОЯНИЕ ============
      let currentScreen = 0;
      let spinBalance = parseInt(sessionStorage.getItem('dartvel_spins') || '0', 10);
      let isSpinning = false;
      let currentRotation = 0;
      let spinHistory = JSON.parse(sessionStorage.getItem('dartvel_history') || '[]');
      let animationId = null;
      let hasVisitedPayment = sessionStorage.getItem('dartvel_visited_payment') === 'true';
      let mouseX = window.innerWidth / 2;
      let mouseY = window.innerHeight / 2;

      // ============ ИНИЦИАЛИЗАЦИЯ ============
      function init() {
        updateSpinDisplay();
        drawWheel(currentRotation);
        renderHistory();
        createParticles();
        createGoldParticles();
        bindEvents();
        trackMouseMovement();

        if (hasVisitedPayment) {
          iPaidBtn.classList.remove('hidden');
        }

        if (sessionStorage.getItem('dartvel_screen') === 'roulette') {
          goToScreen(1, false);
        }
      }

      function saveState() {
        sessionStorage.setItem('dartvel_spins', spinBalance);
        sessionStorage.setItem('dartvel_history', JSON.stringify(spinHistory));
        sessionStorage.setItem('dartvel_screen', currentScreen === 1 ? 'roulette' : 'landing');
        sessionStorage.setItem('dartvel_visited_payment', hasVisitedPayment);
      }

      // ============ ОТСЛЕЖИВАНИЕ КУРСОРА ============
      function trackMouseMovement() {
        document.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
        });

        // Для мобильных устройств используем случайное движение
        if ('ontouchstart' in window) {
          setInterval(() => {
            mouseX = Math.random() * window.innerWidth;
            mouseY = Math.random() * window.innerHeight;
          }, 3000);
        }
      }

      // ============ ИНТЕРАКТИВНЫЕ ЗОЛОТЫЕ ЧАСТИЦЫ ============
      function createGoldParticles() {
        const particleShapes = [
          '✦', '✧', '◆', '◈', '⬥', '♦', '●', '★'
        ];
        
        // Создаем 25-30 частиц для первого экрана
        const particleCount = window.innerWidth <= 480 ? 20 : 30;
        
        for (let i = 0; i < particleCount; i++) {
          const particle = document.createElement('div');
          particle.className = 'gold-particle';
          
          // Случайный символ
          const shape = particleShapes[Math.floor(Math.random() * particleShapes.length)];
          particle.textContent = shape;
          
          // Случайный размер
          const size = 12 + Math.random() * 24;
          particle.style.fontSize = size + 'px';
          
          // Случайная позиция
          const startX = Math.random() * 100;
          const startY = Math.random() * 100;
          particle.style.left = startX + '%';
          particle.style.top = startY + '%';
          
          // Золотой цвет с вариациями
          const goldShade = Math.random() > 0.5 ? '#ffd700' : '#f0c040';
          particle.style.color = goldShade;
          
          // Случайная задержка анимации
          particle.style.animationDelay = -(Math.random() * 8) + 's';
          
          // Сохраняем начальные координаты
          particle.dataset.startX = startX;
          particle.dataset.startY = startY;
          particle.dataset.speed = 0.02 + Math.random() * 0.05;
          
          goldParticlesContainer.appendChild(particle);
        }

        // Запускаем анимацию следования за курсором
        animateGoldParticles();
      }

      function animateGoldParticles() {
        const particles = goldParticlesContainer.querySelectorAll('.gold-particle');
        
        function updateParticles() {
          if (currentScreen !== 0) {
            requestAnimationFrame(updateParticles);
            return;
          }

          particles.forEach(particle => {
            const startX = parseFloat(particle.dataset.startX);
            const startY = parseFloat(particle.dataset.startY);
            const speed = parseFloat(particle.dataset.speed);
            
            // Вычисляем смещение относительно курсора
            const mouseXNorm = (mouseX / window.innerWidth) * 100;
            const mouseYNorm = (mouseY / window.innerHeight) * 100;
            
            const offsetX = (mouseXNorm - startX) * speed * 2;
            const offsetY = (mouseYNorm - startY) * speed * 2;
            
            // Применяем смещение через CSS-переменные
            particle.style.transform = `translate(${offsetX}px, ${offsetY}px)`;
          });

          requestAnimationFrame(updateParticles);
        }

        updateParticles();
      }

      // ============ НАВИГАЦИЯ МЕЖДУ ЭКРАНАМИ ============
      function goToScreen(index, animate = true) {
        currentScreen = index;
        if (animate) {
          appContainer.style.transform = `translateY(-${index * 100}vh)`;
        } else {
          appContainer.style.transition = 'none';
          appContainer.style.transform = `translateY(-${index * 100}vh)`;
          requestAnimationFrame(() => {
            appContainer.style.transition = 'transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
          });
        }
        saveState();
      }

      // ============ ОБРАБОТЧИКИ СОБЫТИЙ ============
      function bindEvents() {
        goToRouletteBtn.addEventListener('click', () => goToScreen(1));

        let touchStartY = 0;
        document.addEventListener('touchstart', (e) => {
          touchStartY = e.touches[0].clientY;
        }, { passive: true });

        document.addEventListener('touchend', (e) => {
          if (isSpinning) return;
          const deltaY = e.changedTouches[0].clientY - touchStartY;
          if (Math.abs(deltaY) > 50) {
            if (deltaY < -40 && currentScreen === 0) goToScreen(1);
            if (deltaY > 40 && currentScreen === 1) goToScreen(0);
          }
        });

        document.addEventListener('wheel', (e) => {
          if (isSpinning) return;
          if (e.deltaY > 30 && currentScreen === 0) {
            e.preventDefault();
            goToScreen(1);
          } else if (e.deltaY < -30 && currentScreen === 1) {
            e.preventDefault();
            goToScreen(0);
          }
        }, { passive: false });

        buySpinsBtn.addEventListener('click', () => {
          window.open('https://playerok.com/profile/DartvelUc/products', '_blank');
          hasVisitedPayment = true;
          saveState();
          iPaidBtn.classList.remove('hidden');
        });

        iPaidBtn.addEventListener('click', () => {
          const confirmed = confirm(
            '⚠️ Внимание! Вы действительно оплатили?\n\n' +
            'Нажимайте «Да» только если оплата прошла успешно. ' +
            'Попытка обмана карается баном. Продолжить?'
          );
          if (confirmed) {
            spinBalance += 1;
            updateSpinDisplay();
            saveState();
            showToast('+1 спин 🎫');
          }
        });

        spinActionBtn.addEventListener('click', spinWheel);
        modalCloseBtn.addEventListener('click', closeModal);
        modalOverlay.addEventListener('click', (e) => {
          if (e.target === modalOverlay) closeModal();
        });
      }

      // ============ УПРАВЛЕНИЕ БАЛАНСОМ ============
      function updateSpinDisplay() {
        spinBalanceEl.textContent = spinBalance;
        spinActionBtn.disabled = spinBalance <= 0 || isSpinning;
      }

      function showToast(message) {
        const toast = document.createElement('div');
        toast.className = 'toast';
        toast.textContent = message;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 2200);
        playTone(800, 0.08, 'sine');
      }

      // ============ РИСОВАНИЕ КОЛЕСА ============
      function drawWheel(rotation) {
        const w = wheelCanvas.width;
        const h = wheelCanvas.height;
        const centerX = w / 2;
        const centerY = h / 2;
        const radius = w / 2 - 10;

        ctx.clearRect(0, 0, w, h);

        ctx.save();
        ctx.beginPath();
        ctx.arc(centerX, centerY, radius + 6, 0, Math.PI * 2);
        ctx.fillStyle = '#ffd700';
        ctx.shadowColor = '#ffd700';
        ctx.shadowBlur = 18;
        ctx.fill();
        ctx.restore();

        SECTORS.forEach((sector) => {
          const start = sector.startAngle + rotation;
          const end = sector.endAngle + rotation;

          const grad = ctx.createLinearGradient(
            centerX + Math.cos(start) * radius * 0.5,
            centerY + Math.sin(start) * radius * 0.5,
            centerX + Math.cos(end) * radius * 0.5,
            centerY + Math.sin(end) * radius * 0.5
          );
          if (sector.rare) {
            grad.addColorStop(0, '#fff8c0');
            grad.addColorStop(0.5, '#ffd700');
            grad.addColorStop(1, '#b8860b');
          } else {
            grad.addColorStop(0, sector.color);
            grad.addColorStop(1, '#222');
          }

          ctx.beginPath();
          ctx.moveTo(centerX, centerY);
          ctx.arc(centerX, centerY, radius, start, end);
          ctx.closePath();
          ctx.fillStyle = grad;
          ctx.fill();
          ctx.strokeStyle = '#0a0a0a';
          ctx.lineWidth = 2;
          ctx.stroke();

          ctx.save();
          const textAngle = start + (end - start) / 2;
          ctx.translate(
            centerX + Math.cos(textAngle) * radius * 0.7,
            centerY + Math.sin(textAngle) * radius * 0.7
          );
          ctx.rotate(textAngle + Math.PI / 2);
          ctx.fillStyle = '#fff';
          ctx.font = 'bold 12px Montserrat';
          ctx.textAlign = 'center';
          ctx.shadowColor = '#000';
          ctx.shadowBlur = 4;
          ctx.fillText(sector.icon, 0, -8);
          ctx.font = '8px Montserrat';
          ctx.fillText(sector.name.substring(0, 10), 0, 10);
          ctx.restore();
        });

        ctx.beginPath();
        ctx.arc(centerX, centerY, 22, 0, Math.PI * 2);
        ctx.fillStyle = '#0a0a0a';
        ctx.fill();
        ctx.strokeStyle = '#ffd700';
        ctx.lineWidth = 3;
        ctx.stroke();
        ctx.fillStyle = '#ffd700';
        ctx.font = 'bold 14px Montserrat';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('DART', centerX, centerY);
      }

      // ============ ВЫБОР ПРИЗА ============
      function selectPrize() {
        const rand = Math.random();
        let cumulative = 0;
        for (const item of ITEMS) {
          cumulative += item.probability;
          if (rand <= cumulative) return item;
        }
        return ITEMS[ITEMS.length - 1];
      }

      // ============ ВРАЩЕНИЕ РУЛЕТКИ ============
      function spinWheel() {
        if (isSpinning || spinBalance <= 0) return;
        isSpinning = true;
        spinBalance -= 1;
        updateSpinDisplay();
        saveState();

        wheelCanvas.classList.add('spinning');

        const prize = selectPrize();
        const prizeIndex = ITEMS.findIndex(item => item.name === prize.name);
        const sectorAngle = (Math.PI * 2) / ITEMS.length;
        const targetSectorCenter = sectorAngle * prizeIndex + sectorAngle / 2;
        const pointerAngle = -Math.PI / 2;
        let targetRotation = pointerAngle - targetSectorCenter;
        while (targetRotation < 0) targetRotation += Math.PI * 2;
        const extraTurns = (4 + Math.random() * 3) * Math.PI * 2;
        const finalRotation = currentRotation + extraTurns + (targetRotation - (currentRotation % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);

        const startRotation = currentRotation;
        const duration = 3200 + Math.random() * 800;
        const startTime = performance.now();

        let tickInterval = setInterval(() => playTick(), 60);

        function animateSpin(now) {
          const elapsed = now - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          currentRotation = startRotation + (finalRotation - startRotation) * eased;
          drawWheel(currentRotation);

          if (progress > 0.7) {
            clearInterval(tickInterval);
            tickInterval = setInterval(() => playTick(), 120 + (progress - 0.7) * 400);
          }

          if (progress < 1) {
            animationId = requestAnimationFrame(animateSpin);
          } else {
            clearInterval(tickInterval);
            wheelCanvas.classList.remove('spinning');
            isSpinning = false;
            updateSpinDisplay();
            saveState();
            showResultModal(prize);
            addHistoryEntry(prize);
            if (prize.rare) playRareWinSound();
            else playWinSound();
          }
        }

        animationId = requestAnimationFrame(animateSpin);
      }

      // ============ МОДАЛЬНОЕ ОКНО ============
      function showResultModal(prize) {
        modalIcon.textContent = prize.icon;
        modalName.textContent = prize.name;
        modalManager.textContent = '@Dartvel_Manager';
        if (prize.rare) {
          modalIcon.classList.add('rare');
          modalName.style.color = '#ffd700';
          spawnGoldParticles();
        } else {
          modalIcon.classList.remove('rare');
          modalName.style.color = prize.color || '#fff';
        }
        modalOverlay.classList.add('active');
      }

      function closeModal() {
        modalOverlay.classList.remove('active');
      }

      function spawnGoldParticles() {
        const container = document.querySelector('.modal-card');
        if (!container) return;
        for (let i = 0; i < 25; i++) {
          const particle = document.createElement('div');
          particle.style.cssText = `
            position: absolute;
            width: 6px;
            height: 6px;
            background: radial-gradient(circle, #ffd700, #b8860b);
            border-radius: 50%;
            pointer-events: none;
            left: 50%;
            top: 50%;
            animation: goldBurst ${0.8 + Math.random()}s ease-out forwards;
            transform: translate(-50%, -50%);
            --dx: ${(Math.random() - 0.5) * 200}px;
            --dy: ${(Math.random() - 0.5) * 200}px;
          `;
          container.appendChild(particle);
          setTimeout(() => particle.remove(), 1500);
        }
      }

      // ============ ИСТОРИЯ СПИНОВ ============
      function addHistoryEntry(prize) {
        const entry = {
          name: prize.name,
          icon: prize.icon,
          time: new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit', second: '2-digit' }),
          rare: prize.rare
        };
        spinHistory.unshift(entry);
        if (spinHistory.length > 20) spinHistory.pop();
        saveState();
        renderHistory();
      }

      function renderHistory() {
        if (spinHistory.length === 0) {
          historyList.innerHTML = '<div style="color:#555;text-align:center;padding:15px;">Пока нет спинов</div>';
          return;
        }
        historyList.innerHTML = spinHistory.map(entry => `
          <div class="history-item" style="${entry.rare ? 'border: 1px solid #ffd70055; box-shadow: 0 0 10px #ffd70022;' : ''}">
            <span class="history-icon">${entry.icon}</span>
            <div class="history-details">
              <span class="history-name" style="color:${entry.rare ? '#ffd700' : '#ddd'}">${entry.name}</span>
              <span class="history-time">${entry.time}</span>
              <span class="history-manager">@Dartvel_Manager</span>
            </div>
          </div>
        `).join('');
      }

      // ============ ФОНОВЫЕ ЧАСТИЦЫ ============
      function createParticles() {
        for (let i = 0; i < 35; i++) {
          const particle = document.createElement('div');
          particle.className = 'particle';
          const size = 2 + Math.random() * 5;
          particle.style.width = size + 'px';
          particle.style.height = size + 'px';
          particle.style.left = Math.random() * 100 + '%';
          particle.style.top = Math.random() * 100 + '%';
          particle.style.animationDuration = 8 + Math.random() * 18 + 's';
          particle.style.animationDelay = Math.random() * 10 + 's';
          particlesBg.appendChild(particle);
        }
      }

      // ============ ЗВУКИ ============
      let audioCtx = null;
      function getAudioContext() {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
        return audioCtx;
      }

      function playTone(freq, duration, type = 'sine', vol = 0.08) {
        try {
          const ctx = getAudioContext();
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, ctx.currentTime);
          gain.gain.setValueAtTime(vol, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(ctx.currentTime);
          osc.stop(ctx.currentTime + duration);
        } catch (e) {}
      }

      function playTick() { playTone(900 + Math.random() * 300, 0.04, 'square', 0.03); }
      
      function playWinSound() {
        playTone(600, 0.15, 'sine', 0.1);
        setTimeout(() => playTone(800, 0.15, 'sine', 0.1), 150);
        setTimeout(() => playTone(1000, 0.2, 'sine', 0.12), 300);
      }

      function playRareWinSound() {
        playTone(500, 0.1, 'triangle', 0.08);
        setTimeout(() => playTone(700, 0.1, 'triangle', 0.1), 100);
        setTimeout(() => playTone(900, 0.1, 'triangle', 0.12), 200);
        setTimeout(() => playTone(1200, 0.3, 'sine', 0.15), 300);
        setTimeout(() => playTone(1500, 0.4, 'sine', 0.18), 450);
      }

      // Динамический стиль для золотых частиц
      const styleSheet = document.createElement('style');
      styleSheet.textContent = `
        @keyframes goldBurst {
          0% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
          100% { opacity: 0; transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(0); }
        }
      `;
      document.head.appendChild(styleSheet);

      // Запуск
      init();
    })();
  </script>
</body>
